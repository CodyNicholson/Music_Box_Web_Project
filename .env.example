# Copy to .env (git-ignored). pipeline-run.sh generates JWT_SECRET and DB_PASSWORD when missing.

# Required: signs session cookies (at least 16 characters, e.g. openssl rand -hex 32)
JWT_SECRET=
# Required: Postgres password (openssl rand -hex 24). Only applies when the volume is first created.
DB_PASSWORD=

# Cloudflare Access (Google sign-in). Team domain: Zero Trust -> Settings -> Custom Pages.
# AUD: Access -> Applications -> (app) -> Overview.
CF_TEAM_DOMAIN=
CF_POLICY_AUD=
