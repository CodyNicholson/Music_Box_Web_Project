DATABASE_URL=postgresql://musicbox:musicbox@localhost:5434/musicbox
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# Cloudflare Access Zero Trust (Google OAuth sign-in)
# Zero Trust Dashboard -> Settings -> Custom Pages -> Team Domain
CF_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# Zero Trust Dashboard -> Access -> Applications -> Edit -> Overview -> AUD Tag
CF_POLICY_AUD=your_application_aud_tag_here

# Local development only (never in production): trust X-Dev-Email / DEV_CF_EMAIL instead of Cloudflare Access
ALLOW_DEV_AUTH=false
DEV_CF_EMAIL=
